APP_ENV=production
APP_DEBUG=false
APP_URL=https://baza.altaj-otdyh.ru
APP_AUTH_RETURN_URI=svetofor2://oauth/callback
APP_TIMEZONE=Asia/Barnaul

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=svetofor22
DB_USERNAME=svetofor_user
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4

# VK ID application. The same VK ID app is used for VK and OK sign-in.
VK_ID_CLIENT_ID=
VK_ID_SERVICE_TOKEN=
VK_ID_SCOPE=vkid.personal_info email

# Yandex ID application. PKCE is used; client secret is not sent in the code exchange.
YANDEX_CLIENT_ID=
YANDEX_SCOPE=login:info login:email login:avatar

# OneSignal server credentials. Never place the REST API key in Android.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
