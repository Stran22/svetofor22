{
  "name": "stran22/svetofor22",
  "description": "Svetofor22 grocery catalog API and administration backend",
  "type": "project",
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "phpoffice/phpspreadsheet": "^2.1",
    "ext-curl": "*",
    "ext-iconv": "*",
    "ext-mbstring": "*",
    "ext-fileinfo": "*",
    "ext-zip": "*",
    "ext-xml": "*",
    "ext-xmlreader": "*",
    "ext-xmlwriter": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "check": "find app public_html bin tests -name '*.php' -print0 | xargs -0 -n1 php -l",
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.1.0"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
